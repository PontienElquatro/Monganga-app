# =====================================================================
# MONGANGA — variables d'environnement
# Copier ce fichier en .env.local (développement) et remplir les valeurs.
# Sur Vercel : Project → Settings → Environment Variables.
# Ne jamais mettre les vraies valeurs dans le dépôt.
# =====================================================================

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé pour la tâche planifiée /api/cron (Vercel l'envoie automatiquement)
CRON_SECRET=

# ---------------------------------------------------------------------
# Paiement — "test" tant que le compte marchand n'est pas ouvert.
# Valeurs possibles : test | maishapay
# En "test", un écran simule le paiement (aucun argent ne circule).
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=test
MAISHAPAY_PUBLIC_KEY=
MAISHAPAY_SECRET_KEY=
MAISHAPAY_GATEWAY_MODE=0
MAISHAPAY_CALLBACK_SECRET=

# ---------------------------------------------------------------------
# Visio (Daily.co) — vide = mode test (pas de vidéo réelle)
# DAILY_DOMAIN : la partie avant .daily.co (ex. monganga-app)
# ---------------------------------------------------------------------
DAILY_API_KEY=
DAILY_DOMAIN=

# ---------------------------------------------------------------------
# E-mails (Resend) — vide = les e-mails sont seulement écrits dans les journaux
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="MONGANGA <notifications@monganga.cd>"

# ---------------------------------------------------------------------
# Photos de profil (Cloudinary) — vide = ajout de photo désactivé
# ---------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
