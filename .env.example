# Copier vers .env.local (jamais commité). Les valeurs viennent de Junior, en privé.

# --- Supabase (backend) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVEUR UNIQUEMENT : jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Front (branche frontend) ---
# demo : parcours fictifs, sans backend. api : le front appelle /api/v1 (branché sur Supabase).
# Le mode est figé au build : relancer `npm run dev` / `npm run build` après modification.
NEXT_PUBLIC_MONGANGA_MODE=demo
# Origines HTTPS autorisées pour les liens de paiement et de documents (liste séparée par des virgules).
NEXT_PUBLIC_PAYMENT_ORIGINS=
NEXT_PUBLIC_DOCUMENT_ORIGINS=
