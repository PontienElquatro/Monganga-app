{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monganga",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  // Garde les variables d'exécution saisies dans le tableau de bord Cloudflare à chaque déploiement.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
